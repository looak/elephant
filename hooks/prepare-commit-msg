#!/bin/sh
# Appends "Bench: <nodes>" from doc/bench-result to the commit message, OpenBench reads the bench from there.
#
# Install once per clone:   git config core.hooksPath hooks
# Refresh after any change that affects search, from ob_build:   ./elephant_ob bench | tail -1 > ../doc/bench-result

msg_file="$1"
commit_type="$2"   # message, template, merge, squash, or commit (amend / -c / -C)

# merges and squashes aren't benched.
case "$commit_type" in
    merge|squash) exit 0 ;;
esac

bench_file="$(git rev-parse --show-toplevel)/doc/bench-result"
[ -f "$bench_file" ] || exit 0

# first number in the file is the node count, e.g. "48460682 nodes 3727744 nps".
nodes=$(grep -o '[0-9][0-9]*' "$bench_file" | head -n 1)
[ -n "$nodes" ] || exit 0

# don't add it twice, an amend or a message that already has one keeps it.
grep -qi '^bench[: ]' "$msg_file" && exit 0

printf '\nBench: %s\n' "$nodes" >> "$msg_file"
