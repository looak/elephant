#!/bin/sh
# Adds a "bench <nodes> nodes" line to the commit message, OpenBench reads the bench from the branch's newest commit.
#
# When the commit changes the engine (src/engine, src/cli/src or ob_build/makefile) the bench is run, built with
# ob_build/makefile and g++ like OpenBench builds it, other compilers give other node counts. Without g++ and make on
# PATH (Windows) the build runs through WSL. Otherwise the bench line of the last commit that has one is reused.
#
#   ELEPHANT_BENCH=force git commit ...   run the bench even when no engine file changed, e.g. to fix an amend
#   ELEPHANT_BENCH=skip  git commit ...   no bench line at all
#
# The bench builds the working tree, unstaged engine changes end up in it. A warning is printed when there are any.
#
# This tracked copy is the source, git runs it from .git/hooks. Install or update once per clone, from the repo root:
#   cp hooks/prepare-commit-msg .git/hooks/ && chmod +x .git/hooks/prepare-commit-msg

msg_file="$1"
[ "$ELEPHANT_BENCH" = "skip" ] && exit 0

root="$(git rev-parse --show-toplevel)"
engine_paths="src/engine src/cli/src ob_build/makefile"

run_bench() {
    # build objects & binary stay in ob_build/build, which is ignored.
    build='cd ob_build && make -j"$(nproc)" EXE=build/elephant_ob >/dev/null 2>&1 && ./build/elephant_ob bench | tail -n 1'
    if command -v g++ >/dev/null 2>&1 && command -v make >/dev/null 2>&1; then
        (cd "$root" && sh -c "$build")
    elif command -v wsl.exe >/dev/null 2>&1; then
        wsl_root="$(wsl.exe -e wslpath -a "$root" | tr -d '\r')"
        wsl.exe -e sh -c "cd '$wsl_root' && $build" | tr -d '\r'
    else
        echo "prepare-commit-msg: no g++/make or WSL found, can't run the bench" >&2
    fi
}

engine_changed=0
# initial commit has no HEAD, everything is new.
if ! git rev-parse --verify -q HEAD >/dev/null || ! git diff --cached --quiet HEAD -- $engine_paths; then
    engine_changed=1
fi

nodes=""
if [ "$engine_changed" = 1 ] || [ "$ELEPHANT_BENCH" = "force" ]; then
    git diff --quiet -- $engine_paths || echo "prepare-commit-msg: unstaged engine changes are part of the bench" >&2
    echo "prepare-commit-msg: running bench..." >&2
    # e.g. "1710707 nodes 2259850 nps", the first number is the node count.
    nodes=$(run_bench | grep -o '^[0-9][0-9]* nodes' | grep -o '^[0-9]*')
    if [ -z "$nodes" ]; then
        echo "prepare-commit-msg: bench failed, no bench line added" >&2
        exit 0
    fi
    echo "prepare-commit-msg: bench $nodes nodes" >&2
else
    nodes=$(git log --format=%B -n 200 HEAD 2>/dev/null | grep -m 1 -o '^bench [0-9][0-9]* nodes' | grep -o '[0-9][0-9]*')
    [ -n "$nodes" ] || exit 0
fi

# Any existing bench line is replaced (amend). The bench line isn't a "Key: value" trailer, so it goes in its own
# paragraph before the trailer block (Co-Authored-By etc.), otherwise git no longer reads the trailers.
tmp_file="$msg_file.bench"
awk -v bench="bench $nodes nodes" '
    /^bench [0-9]+ nodes[[:space:]]*$/ { next }
    # collapse the blank lines a removed bench line leaves behind.
    /^[[:space:]]*$/ && n > 0 && lines[n] ~ /^[[:space:]]*$/ { next }
    { lines[++n] = $0 }
    END {
        # last line of content, comment lines from the editor template stay where they are.
        last = n
        while (last > 0 && (lines[last] ~ /^#/ || lines[last] ~ /^[[:space:]]*$/)) last--

        # first line of the last paragraph, a trailer block only if every line is a trailer and it isnt the subject.
        first = last
        while (first > 1 && lines[first - 1] !~ /^[[:space:]]*$/) first--
        trailers = first > 1
        for (i = first; i <= last && trailers; i++)
            if (lines[i] !~ /^[A-Za-z0-9-]+: /) trailers = 0

        if (trailers) {
            for (i = 1; i < first; i++) print lines[i]
            print bench
            print ""
            for (i = first; i <= n; i++) print lines[i]
        } else {
            for (i = 1; i <= last; i++) print lines[i]
            if (last > 0) print ""
            print bench
            # what follows the content is editor comments, keep them one blank line below.
            for (i = last + 1; i <= n && lines[i] ~ /^[[:space:]]*$/; i++) ;
            if (i <= n) print ""
            for (; i <= n; i++) print lines[i]
        }
    }
' "$msg_file" > "$tmp_file" && mv "$tmp_file" "$msg_file"
