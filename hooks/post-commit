#!/bin/sh
# Syncs the smoke results, see test/RESULTS.md: a wip run, recorded on a dirty tree, becomes the record of the commit
# that has exactly that tree, and runs nyayo hasn't got are uploaded. Quiet unless something changed, never fails
# the commit.
#
# This tracked copy is the source, git runs it from .git/hooks. Install or update once per clone, from the repo root:
#   cp hooks/post-commit .git/hooks/ && chmod +x .git/hooks/post-commit

root="$(git rev-parse --show-toplevel)"
[ -d "$root/logs/results" ] || exit 0

for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys; sys.exit(sys.version_info < (3, 9))" 2>/dev/null; then
        "$candidate" "$root/test/results.py" sync --quiet 2>/dev/null
        exit 0
    fi
done
exit 0
