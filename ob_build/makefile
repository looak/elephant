# THIS MAKEFILE IS ONLY INTENDED FOR OPENBENCH
EXE ?= elephant_ob

# Versioning, read from ../version.txt (major.minor.patch[-label]), the only place the version is written.
VERSION_FILE := ../version.txt
VERSION_FULL := $(shell head -n 1 $(VERSION_FILE) | tr -d '\r[:space:]')
VERSION_CORE := $(firstword $(subst -, ,$(VERSION_FULL)))
export ElephantGambit_VERSION_MAJOR = $(word 1,$(subst ., ,$(VERSION_CORE)))
export ElephantGambit_VERSION_MINOR = $(word 2,$(subst ., ,$(VERSION_CORE)))
export ElephantGambit_VERSION_PATCH = $(word 3,$(subst ., ,$(VERSION_CORE)))
export ElephantGambit_VERSION = $(VERSION_CORE)
# includes the leading dash, "-eval", or empty for a release.
export ElephantGambit_VERSION_PRERELEASE = $(patsubst $(VERSION_CORE)%,%,$(VERSION_FULL))
GIT_HASH := $(shell git rev-parse --short HEAD 2>/dev/null || echo nogit)
BUILD_TIMESTAMP := $(shell date '+%b %d %Y at %H:%M:%S')

# Directories
BUILD_DIR := ./build
CSRC_DIR := ../src/cli/src
ESRC_DIR := ../src/engine/src

# Versioning header and template. The header goes in the build directory, the CMake build writes its own next to the
# template and the two would overwrite each other. Its include path comes first so this one is found.
VERSION_HEADER_DIR := $(BUILD_DIR)/gen
VERSION_HEADER := $(VERSION_HEADER_DIR)/elephant_gambit_config.h
VERSION_HEADER_TEMPLATE := ../src/engine/inc/elephant_gambit_config.h.in

INCLUDE_PATHS := $(VERSION_HEADER_DIR) ../src/engine/inc ../src/cli/inc ../third_party/spdlog/include
INC_DIR := $(addprefix -I,$(INCLUDE_PATHS))

# Compiler and flags
# ARCH is the -march target, native for OpenBench. Release builds pass portable levels: x86-64, x86-64-v2, x86-64-v3.
# LDFLAGS is added when linking, release builds pass -static so the binary runs without the compiler's runtime.
CXX := g++
ARCH ?= native
LDFLAGS ?=
CXXFLAGS := -std=c++2a -O3 -flto=auto -march=$(ARCH) -MMD -MP $(INC_DIR) -Wall -Wextra -Wpedantic -Wshadow -Wsign-conversion -Wno-unknown-pragmas -Wunused-variable -Wunused-parameter -Wconversion

# Source files
ENGINE_SRC := $(shell find $(ESRC_DIR) -name "*.cpp")
COMMAND_SRC := $(CSRC_DIR)/commands/uci_commands.cpp $(CSRC_DIR)/commands/command_processor.cpp
SRC := $(CSRC_DIR)/openbench.cpp $(COMMAND_SRC) $(ENGINE_SRC)

# Object files mirror the source tree (../src/a/b.cpp -> build/src/a/b.o), sources with the same file name in
# different directories (move_generator.cpp and tusk/move_generator.cpp) must not share an object file.
OBJ := $(patsubst ../%.cpp,$(BUILD_DIR)/%.o,$(SRC))
DEP := $(OBJ:.o=.d)

# Executable in bin directory
EXE_PATH := $(EXE)

# Phony targets
.PHONY: all clean

# Main target
all: $(EXE_PATH)

# Executable dependency on object files AND version header
$(EXE_PATH): $(OBJ)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^

# Object file compilation rule
$(BUILD_DIR)/%.o: ../%.cpp $(VERSION_HEADER)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Header dependencies generated by -MMD -MP
-include $(DEP)

# Version header generation rule (simplified for readability)
$(VERSION_HEADER): $(VERSION_HEADER_TEMPLATE) $(VERSION_FILE)
	@mkdir -p $(dir $@)
	sed -e 's/@ElephantGambit_VERSION_MAJOR@/$(ElephantGambit_VERSION_MAJOR)/g' \
		-e 's/@ElephantGambit_VERSION_MINOR@/$(ElephantGambit_VERSION_MINOR)/g' \
		-e 's/@ElephantGambit_VERSION_PATCH@/$(ElephantGambit_VERSION_PATCH)/g' \
		-e 's/@ElephantGambit_VERSION@/$(ElephantGambit_VERSION)/g' \
		-e 's/@ElephantGambit_VERSION_PRERELEASE@/$(ElephantGambit_VERSION_PRERELEASE)/g' \
		-e 's/@ElephantGambit_VERSION_SUFFIX@//g' \
		-e 's/@VAR_ELEPHANT_GIT_HASH@/$(GIT_HASH)/g' \
		-e 's/@VAR_ELEPHANT_BUILD_TIMESTAMP@/$(BUILD_TIMESTAMP)/g' \
		$< > $@

# Clean rule
clean:
	rm -rf $(BUILD_DIR) $(EXE_PATH) $(VERSION_HEADER)

# Debug rule
print-%:
	@echo $* = $($*)
