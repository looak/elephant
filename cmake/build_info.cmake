# --- Build info, run on every build ---
# cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -DCONFIG=<config> -P build_info.cmake
# Writes the commit the binary is built from, whether the working tree had changes and the branch, for the UCI
# "buildinfo" command. Configure time is too early, the commit changes without CMake configuring again. The header is
# only rewritten when its content changes, so a build on the same commit recompiles nothing.
# ob_build/makefile writes the same header with git & sed, keep the two alike.

set(BUILD_COMMIT "")
set(BUILD_DIRTY 0)
set(BUILD_BRANCH "")

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
        WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE BUILD_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(BUILD_COMMIT)
        # untracked files count, a new source file is part of the build.
        execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain
            WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE BUILD_STATUS ERROR_QUIET)
        if(BUILD_STATUS)
            set(BUILD_DIRTY 1)
        endif()
        # empty on a detached HEAD.
        execute_process(COMMAND ${GIT_EXECUTABLE} symbolic-ref --short -q HEAD
            WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE BUILD_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    endif()
endif()

string(TOLOWER "${CONFIG}" BUILD_CONFIG)

set(BUILD_INFO_CONTENT "// generated by cmake/build_info.cmake, don't edit
#pragma once
#define ELEPHANT_GAMBIT_GIT_COMMIT \"${BUILD_COMMIT}\"
#define ELEPHANT_GAMBIT_GIT_DIRTY ${BUILD_DIRTY}
#define ELEPHANT_GAMBIT_GIT_BRANCH \"${BUILD_BRANCH}\"
#define ELEPHANT_GAMBIT_BUILD_CONFIG \"${BUILD_CONFIG}\"
")

# configure_file leaves OUTPUT untouched when it already holds this content.
file(WRITE ${OUTPUT}.tmp "${BUILD_INFO_CONTENT}")
configure_file(${OUTPUT}.tmp ${OUTPUT} COPYONLY)
file(REMOVE ${OUTPUT}.tmp)
