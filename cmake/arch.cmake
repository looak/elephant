# The instruction set to compile for, see ELEPHANT_ARCH in options.cmake, and what a binary is named after: eg-uci is
# eg-uci-<version>-<os>-<instructions>, with -dev when it has assertions. ob_build/makefile & release.yml name theirs alike.

if(ELEPHANT_ARCH STREQUAL "native")
    set(ELEPHANT_MARCH native)
    set(ELEPHANT_MSVC_ARCH /arch:AVX2)
    set(ELEPHANT_ARCH_NAME x86-64-native)
elseif(ELEPHANT_ARCH STREQUAL "x86-64")
    set(ELEPHANT_MARCH x86-64)
    set(ELEPHANT_MSVC_ARCH "")
    set(ELEPHANT_ARCH_NAME x86-64)
elseif(ELEPHANT_ARCH STREQUAL "sse42")
    set(ELEPHANT_MARCH x86-64-v2)
    set(ELEPHANT_MSVC_ARCH /arch:SSE4.2)
    set(ELEPHANT_ARCH_NAME x86-64-sse42-popcnt)
elseif(ELEPHANT_ARCH STREQUAL "avx2")
    set(ELEPHANT_MARCH x86-64-v3)
    set(ELEPHANT_MSVC_ARCH /arch:AVX2)
    set(ELEPHANT_ARCH_NAME x86-64-avx2-bmi2)
else()
    message(FATAL_ERROR "ELEPHANT_ARCH is ${ELEPHANT_ARCH}, it can be native, x86-64, sse42 or avx2")
endif()

if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    # clang-cl takes clang's levels through /clang:, so a level means the same as with g++.
    add_compile_options(/clang:-march=${ELEPHANT_MARCH})
elseif(MSVC)
    # MSVC has no native level, the nearest it has is what the binary is then named after.
    if(ELEPHANT_ARCH STREQUAL "native")
        set(ELEPHANT_ARCH_NAME x86-64-avx2-bmi2)
    endif()
    if(ELEPHANT_MSVC_ARCH)
        add_compile_options(${ELEPHANT_MSVC_ARCH})
    endif()
else()
    add_compile_options(-march=${ELEPHANT_MARCH})
endif()
message(STATUS "## Instruction set: ${ELEPHANT_ARCH_NAME}")

if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(ELEPHANT_OS_NAME win)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(ELEPHANT_OS_NAME mac)
else()
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" ELEPHANT_OS_NAME)
endif()

set(ELEPHANT_BINARY_SUFFIX "${VAR_ELEPHANT_VERSION_FULL}-${ELEPHANT_OS_NAME}-${ELEPHANT_ARCH_NAME}")
if(ASSERTIONS_ENABLED)
    string(APPEND ELEPHANT_BINARY_SUFFIX "-dev")
endif()
