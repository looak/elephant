// The search parameters SPSA may tune, one X-macro entry each, and the only place their values are written:
//
//     TUNABLE(group, name, type, defaultValue, minValue, maxValue, step)
//
// group is the namespace the constant lives in, name the constant in it. Three files include this list with their own
// TUNABLE: search_constants.hpp declares the constants, constexpr normally and mutable inline variables in a build with
// ELEPHANT_TUNE; uci.cpp reads them from setoption, and uci_loop.cpp announces them as UCI spin options, both only with
// ELEPHANT_TUNE, as <group>__<name>. minValue and maxValue are the bounds SPSA and setoption clamp to, not what the
// search accepts, step is the delta SPSA may apply between tunes. Integers only: lmr_params' fractional base & divisor
// have no entry, and a constant used where a compile time value is needed (array size, template argument,
// static_assert, if constexpr) can't be here, the tuning build wouldn't compile.
//
// Adding a parameter: add its line here and delete its constant from search_constants.hpp.

#ifndef TUNABLE
#error "define TUNABLE(group, name, type, defaultValue, minValue, maxValue, step) before including search_tunables.def"
#endif

// reverse futility pruning, nodes up to maxDepth return when the static eval beats beta by margin * depth.
TUNABLE(rfp_params, maxDepth, u8,   6,  2,  10,  1)
TUNABLE(rfp_params, margin,   i32, 80, 20, 200, 10)

// futility pruning, quiet moves are skipped at nodes up to maxDepth when the static eval is this far below alpha:
// margin = base + perDepth * depth.
TUNABLE(futility_params, maxDepth, u8,  3,  1,   6,  1)
TUNABLE(futility_params, base,     i16, 100, 50, 200, 10)
TUNABLE(futility_params, perDepth, i16, 100, 50, 200, 10)

// null move pruning. Null move fail highs from verificationDepth up are verified with a reduced normal search before
// cutting, guards against zugzwang where passing is better than any real move. reduction = baseReduction + depth /
// depthDivisor + min((staticEval - beta) / evalDivisor, maxEvalReduction), deeper nodes and a bigger margin over beta
// reduce more. The common 3 + depth / 3 + min(.., 3) never found the zugzwang win in the null move search test, the
// verification search shrinks with the null move's depth.
TUNABLE(nmp_params, minDepth,          u8,  3,   1,   6,  1)
TUNABLE(nmp_params, verificationDepth, u8,  6,   3,  12,  1)
TUNABLE(nmp_params, baseReduction,     i32, 2,   1,   4,  1)
TUNABLE(nmp_params, depthDivisor,      i32, 4,   2,   8,  1)
TUNABLE(nmp_params, evalDivisor,       i32, 200, 100, 400, 15)
TUNABLE(nmp_params, maxEvalReduction,  i32, 1,   0,   3,  1)

// late move pruning, at non-PV nodes up to maxDepth only the first base + factor * depth * depth quiet moves are
// searched. The common 3 + depth * depth pushed the zugzwang win in the null move search test from depth 15 to 20, this
// costs it a ply.
TUNABLE(lmp_params, maxDepth, u8,  5, 2, 10, 1)
TUNABLE(lmp_params, base,     u16, 5, 2, 10, 1)
TUNABLE(lmp_params, factor,   u16, 2, 1,  4, 1)

// singular extensions
TUNABLE(singular_params, depthThreshold, u8, 8, 4, 16, 1)
TUNABLE(singular_params, depthMargin,    i8, 3, 1,  6, 1)

// history heuristic, the bonus for a quiet cutoff move is depth * depth * bonusScale up to maxBonus, the quiets tried
// before it get the same malus.
TUNABLE(history_params, bonusScale, i32, 32,   16,   64,   3)
TUNABLE(history_params, maxBonus,   i32, 2048, 1024, 4096, 150)

// aspiration windows, from minDepth the root is searched in a window around the previous iteration's score, earlier
// scores swing too much. maxDelta, where a side of the window opens up fully, stays a constant.
TUNABLE(aspiration_params, minDepth,     u8,  5,  3, 10, 1)
TUNABLE(aspiration_params, initialDelta, i32, 25, 12, 50, 2)

// quiescence, delta pruning: slack on top of the material a capture can win before it's judged hopeless, 200 is 2
// pawns. defaultMaxDepth stays a constant.
TUNABLE(quiescence_params, deltaMargin, i16, 200, 100, 400, 15)

// late move reductions. Moves before fullDepthMoves are searched at full depth, covers the pv/tt move and usually the
// killers. A ply less per historyDivisor of history, a ply more per that much below zero. The score is three tables of at
// most 16383 each, so at most 5 plies either way, and under this it changes nothing. A first guess, not fitted on
// anything. base & divisor stay constants, they only feed the reduction table built once at startup.
TUNABLE(lmr_params, minDepth,       u8,  3,    1,    6,     1)
TUNABLE(lmr_params, fullDepthMoves, u16, 3,    1,    8,     1)
TUNABLE(lmr_params, historyDivisor, i32, 8192, 4096, 16384, 600)

// internal iterative reduction, nodes from minDepth with neither a TT nor a PV move to search first are searched a ply
// shallower.
TUNABLE(iir_params, minDepth, u8, 4, 2, 8, 1)

#undef TUNABLE
